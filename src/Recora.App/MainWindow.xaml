<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Recora.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recora">
    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1F24" Offset="0" />
                <GradientStop Color="#123A3F" Offset="0.55" />
                <GradientStop Color="#0F6B5C" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="28,20,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="BrandTitle"
                           Text="Recora"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Foreground="#E8E2D6"
                           FontFamily="Segoe UI Variable Display, Georgia, serif" />
                <TextBlock x:Name="BrandSubtitle"
                           Text="Teams call recorder — AI-ready"
                           FontSize="14"
                           Opacity="0.85"
                           Foreground="#E8E2D6"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="LibraryNav" Content="Library" Click="LibraryNav_Click" />
                <Button x:Name="SettingsNav" Content="Settings" Click="SettingsNav_Click" />
            </StackPanel>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" Margin="20,0,20,20" />
    </Grid>
</Window>
