<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Recora.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="560" Spacing="16" Padding="8">
            <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" Foreground="#E8E2D6" />

            <ComboBox x:Name="LanguageBox" Width="220" SelectionChanged="LanguageBox_SelectionChanged">
                <ComboBoxItem Content="Čeština" Tag="cs" />
                <ComboBoxItem Content="Slovenčina" Tag="sk" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>

            <ToggleSwitch x:Name="AutomationSwitch" Toggled="AutomationSwitch_Toggled" />
            <NumberBox x:Name="ChunkMinutes" Minimum="15" Maximum="30" SpinButtonPlacementMode="Inline"
                       ValueChanged="ChunkMinutes_ValueChanged" />

            <ToggleSwitch x:Name="MicSwitch" Toggled="MicSwitch_Toggled" />
            <ComboBox x:Name="MicDeviceBox" Width="360" SelectionChanged="MicDeviceBox_SelectionChanged" />

            <ToggleSwitch x:Name="DoubleVoiceSwitch" Toggled="DoubleVoiceSwitch_Toggled" />

            <TextBox x:Name="FolderBox" Width="360" HorizontalAlignment="Left" LostFocus="FolderBox_LostFocus" />
            <ToggleSwitch x:Name="AutoUploadSwitch" Toggled="AutoUploadSwitch_Toggled" />
            <ToggleSwitch x:Name="DemoDataSwitch" Toggled="DemoDataSwitch_Toggled" />
            <Button x:Name="SeedDemoButton" Click="SeedDemoButton_Click" />
            <Button x:Name="SignInButton" Click="SignInButton_Click" />
            <TextBlock x:Name="StatusText" Foreground="#1FA88F" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
