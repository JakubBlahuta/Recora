<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Recora.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search…" TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="1" x:Name="RefreshButton" Content="↻" Margin="8,0,0,0" Click="RefreshButton_Click" />
        </Grid>

        <ListView x:Name="MeetingList" Grid.Row="1" Margin="8"
                  SelectionChanged="MeetingList_SelectionChanged"
                  IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#E8E2D6" />
                            <TextBlock Foreground="#E8E2D6" Opacity="0.75" FontSize="12">
                                <Run Text="{Binding StartedAtLocal}" />
                                <Run Text=" · " />
                                <Run Text="{Binding DurationLabel}" />
                                <Run Text=" · " />
                                <Run Text="{Binding SizeLabel}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusLabel}"
                                   VerticalAlignment="Center" Foreground="#1FA88F" Margin="12,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Margin="8" Spacing="8">
            <TextBlock x:Name="EmptyText" Foreground="#E8E2D6" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock x:Name="TranscriptPlaceholder" Foreground="#C45C26" FontStyle="Italic" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PlayButton" Click="PlayButton_Click" IsEnabled="False" />
                <Button x:Name="ExportButton" Click="ExportButton_Click" IsEnabled="False" />
                <Button x:Name="DeleteButton" Click="DeleteButton_Click" IsEnabled="False" />
            </StackPanel>
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" Height="180" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
