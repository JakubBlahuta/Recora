<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Recora.App.Views.WizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="16" Padding="8">
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" Foreground="#E8E2D6" />
            <TextBlock x:Name="StepText" Foreground="#E8E2D6" Opacity="0.9" TextWrapping="Wrap" />

            <StackPanel x:Name="LanguagePanel" Spacing="8">
                <TextBlock x:Name="LanguageLabel" Foreground="#E8E2D6" />
                <ComboBox x:Name="LanguageBox" Width="220" SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Content="Čeština" Tag="cs" />
                    <ComboBoxItem Content="Slovenčina" Tag="sk" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
            </StackPanel>

            <CheckBox x:Name="ConsentBox" Foreground="#E8E2D6" />

            <StackPanel Spacing="8">
                <TextBlock x:Name="OneDriveLabel" Foreground="#E8E2D6" TextWrapping="Wrap" />
                <TextBox x:Name="FolderBox" Width="320" HorizontalAlignment="Left" />
                <Button x:Name="SignInButton" Click="SignInButton_Click" />
                <TextBlock x:Name="AuthStatus" Foreground="#1FA88F" />
            </StackPanel>

            <ToggleSwitch x:Name="AutoUploadSwitch" OnContent="ON" OffContent="OFF" />

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                <Button x:Name="FinishButton" Style="{StaticResource AccentButtonStyle}" Click="FinishButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
